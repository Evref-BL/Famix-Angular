"
I link the members read in *ngFor, e.g. items and trackById in *ngFor=""let item of items; trackBy: trackById"".
"
Class {
	#name : 'FamixAngularNgForLinkImporter',
	#superclass : 'FamixAngularStructuralDirectiveLinkImporter',
	#category : 'Famix-Angular-Tools',
	#package : 'Famix-Angular-Tools'
}

{ #category : 'accessing' }
FamixAngularNgForLinkImporter >> directive [
	^ '*ngFor'
]
