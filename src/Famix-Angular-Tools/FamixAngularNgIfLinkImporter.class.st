"
I link the members read in *ngIf, e.g. isLoaded in *ngIf=""isLoaded; else loading"".
"
Class {
	#name : 'FamixAngularNgIfLinkImporter',
	#superclass : 'FamixAngularStructuralDirectiveLinkImporter',
	#category : 'Famix-Angular-Tools',
	#package : 'Famix-Angular-Tools'
}

{ #category : 'accessing' }
FamixAngularNgIfLinkImporter >> directive [
	^ '*ngIf'
]
